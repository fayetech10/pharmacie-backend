.h2data/
.donnees/
.journaux/
*/db/
uploads/

.git/
.gitignore
.idea/
*.iml

# Scripts et docs : n'interviennent pas dans la compilation
demarrer.ps1
*.md
render.yaml
Dockerfile
.dockerignore

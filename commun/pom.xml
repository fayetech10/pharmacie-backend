<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.csu</groupId>
    <artifactId>pharmacie-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
  </parent>

  <!--
    Domaine partagé : com.csu.pharmacie.{entity, dto, exception, utils}.

    Ce sont les classes de l'application historique, déplacées ici sans changer de paquet
    pour qu'il n'en existe qu'UNE définition dans tout le projet — le cœur et les
    microservices travaillent sur les mêmes StructureSanitaire, FactureStructure, Regime…

    Volontairement DÉPOURVU de composant Spring : le cœur scanne « com.csu.pharmacie.** »,
    tout @Component/@RestController déposé ici serait donc enregistré chez lui — et entrerait
    en collision avec les siens. Le socle microservices (filtre JWT, sonde de santé, clients
    inter-services) vit dans le module « socle », dont le cœur ne dépend pas ; le
    gestionnaire d'exceptions et les exceptions applicatives sont restés dans le cœur, à qui
    ils appartiennent.
  -->
  <artifactId>commun</artifactId>
  <name>SEN-CSU :: commun (domaine)</name>

  <dependencies>
    <!-- Annotations JPA et Hibernate (@Entity, @JdbcTypeCode) portées par les entités. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <!-- Contraintes de validation portées par les DTO. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!-- @RestControllerAdvice de GlobalExceptionHandler + @JsonProperty des entités. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
    </dependency>
    <!-- ExcelUtils : lecture des classeurs d'import. -->
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi-ooxml</artifactId>
      <version>${poi.version}</version>
    </dependency>
    <!-- PdfFactureEnfants : la « Liste + facture 0-5 ans », partagée par le cœur (facture d'une
         structure) et le service centre (consolidation du district). -->
    <dependency>
      <groupId>com.itextpdf</groupId>
      <artifactId>itextpdf</artifactId>
      <version>${itext.version}</version>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>
  </dependencies>
</project>

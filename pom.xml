<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Backend SEN-CSU — projet multi-modules.

    « coeur » est l'application historique, inchangée et toujours déployable telle quelle.
    Les autres modules sont les microservices : un par type d'utilisateur (pharmacie, poste
    de santé, centre de santé), deux transverses (identité, référentiel) et une passerelle.

    Le découpage se fait PAR EXTRACTION du cœur, pas par réécriture : les entités du domaine
    vivent dans « commun » et sont partagées, de sorte qu'il n'existe qu'une seule définition
    de StructureSanitaire, FactureStructure, Regime… dans tout le projet.
  -->
  <groupId>com.csu</groupId>
  <artifactId>pharmacie-backend</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>SEN-CSU :: backend</name>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.2.0</version>
    <relativePath/>
  </parent>

  <properties>
    <java.version>17</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <spring-cloud.version>2023.0.0</spring-cloud.version>
    <jjwt.version>0.11.5</jjwt.version>
    <poi.version>5.2.3</poi.version>
    <itext.version>5.5.13.3</itext.version>
    <pdfbox.version>3.0.3</pdfbox.version>
    <springdoc.version>2.3.0</springdoc.version>
  </properties>

  <modules>
    <module>commun</module>
    <module>socle</module>
    <module>coeur</module>
    <module>api-gateway</module>
    <module>service-identite</module>
    <module>service-referentiel</module>
    <module>service-pharmacie</module>
    <module>service-poste-sante</module>
    <module>service-centre-sante</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.csu</groupId>
        <artifactId>commun</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.csu</groupId>
        <artifactId>socle</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <configuration>
            <excludes>
              <exclude>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
              </exclude>
            </excludes>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
